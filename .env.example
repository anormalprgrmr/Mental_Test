# Telegram bot token from @BotFather.
BOT_TOKEN=123456:replace-me

# Backward-compatible alias also supported by the app if BOT_TOKEN is empty:
# BIT_TOKEN=123456:replace-me

# Comma-separated Telegram numeric IDs that receive result notifications.
ADMINS=111111111,222222222

# Optional SQLite database path.
DB_PATH=mental_test.db
